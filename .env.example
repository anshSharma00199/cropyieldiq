# Copy to .env (never commit .env). Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
SECRET_KEY=change-me-generate-a-48-char-random-string
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Database / cache (docker-compose wires these hostnames)
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
DATABASE_URL=postgresql://cyiq:change-me@postgres:5432/cyiq
REDIS_URL=redis://:change-me@redis:6379/0

# First admin account (created at start-up if missing; use a strong password, then remove from .env)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Security / networking
CORS_ORIGINS=https://your-domain.example
TRUST_PROXY=true
MAX_BODY_BYTES=65536
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
RL_IP=120/60        # requests per window(seconds) per IP, all endpoints
RL_USER=60/60       # per authenticated user
RL_AUTH=10/60       # login / register / refresh per IP
METRICS_TOKEN=

# Caching TTLs (seconds)
WEATHER_TTL=1800
PREDICT_TTL=3600

# Model storage: local | s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=models/
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_DEFAULT_REGION=  (or an IAM role)

# Error tracking and notifications (all optional)
SENTRY_DSN=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Monitoring
GRAFANA_PASSWORD=change-me
API_IMAGE=cropyieldiq-api:local
